# Variables de entorno - Gerenciamiento de Viajes

# Puerto del Servidor Backend
PORT=3000

# Base de datos SQLite
DATABASE_PATH=./database/db.sqlite

# Compatibilidad Postgres (según especificación)
POSTGRES_DB=viajes_db
POSTGRES_USER=viajes_user
POSTGRES_PASSWORD=viajes_pass_secret
DATABASE_URL=sqlite:./database/db.sqlite

# Configuración del Bot de Telegram
TELEGRAM_BOT_TOKEN=MODO_DEMO_TOKEN
TELEGRAM_WEB_APP_URL=http://localhost/
TELEGRAM_GROUP_ID=-1001234567890
TELEGRAM_BOT_USERNAME=GerenciamientoViajesBot

# Autenticación JWT y Cookies del Panel Administrativo
ADMIN_JWT_SECRET=super_secret_jwt_key_gerenciamiento_viajes_2026
ADMIN_JWT_EXPIRES_IN=8h
ADMIN_COOKIE_NAME=admin_session_token
ADMIN_COOKIE_SECURE=false

# Límite de Intentos y Bloqueo de Usuarios Administrativos
ADMIN_LOGIN_MAX_ATTEMPTS=3
ADMIN_LOGIN_BLOCK_MINUTES=15
